# For running the web app outside Docker:  cd frontend && cp .env.example .env && npm run dev
# Next.js loads this file automatically. .env is git-ignored.

# Address of the Go API. Used by the server and by the /api/* rewrite in next.config.ts
# (the rewrite is fixed at build time, so rebuild after changing it).
API_URL=http://localhost:18080

# Must match the API's ENABLE_TEST_TOOLS.
ENABLE_TEST_TOOLS=true
