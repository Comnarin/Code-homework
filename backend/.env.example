# For running the API outside Docker:  cd backend && cp .env.example .env && go run ./cmd/server
# Real environment variables always win over this file. .env is git-ignored.

# Required. Matches the Postgres from `docker compose up -d postgres` with the root .env values.
DATABASE_URL=postgres://postgres:change-me@localhost:55432/foodstore?sslmode=disable

# Redis is not published by docker-compose; run your own, or publish its port.
REDIS_ADDR=localhost:6379

# 8080 is often taken by other local tools.
PORT=18080

# Product pictures (optional). Leave MINIO_ENDPOINT empty to serve only the default picture.
# Matches the MinIO from `docker compose up -d minio` with the root .env values.
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET=product-images
MINIO_USE_SSL=false

# true exposes POST /api/test/reset-limits. Keep false anywhere real customers
# can reach; set it to true in your own .env to demo the Red set rule.
ENABLE_TEST_TOOLS=false
