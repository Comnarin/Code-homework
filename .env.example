# Settings for `docker compose up`. Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored; never commit real secrets.

# --- Postgres ---
POSTGRES_USER=postgres
# Required. Avoid characters that need URL-encoding (@ : / ? # %).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=foodstore

# --- MinIO (product pictures) ---
MINIO_ROOT_USER=minioadmin
# Required, at least 8 characters.
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=product-images

# --- Ports published on your machine (containers keep their own ports) ---
POSTGRES_HOST_PORT=55432
API_HOST_PORT=18080
WEB_HOST_PORT=3000
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# --- Test aid ---
# true exposes POST /api/test/reset-limits and the "Reset Red set limit" button.
# Keep false anywhere real customers can reach. For a local demo or manual
# testing of the one-Red-per-hour rule, set it to true in your own .env.
ENABLE_TEST_TOOLS=false
