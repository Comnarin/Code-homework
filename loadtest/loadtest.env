# Settings for the isolated load-test stack (compose project "foodstore-load").
# Passed after .env, so these win. Different database, Redis DB and host ports
# mean a load test can never touch the stack you use for development.
# No secrets here: passwords still come from .env.
ENABLE_TEST_TOOLS=true
POSTGRES_DB=foodstore_load
REDIS_DB=1
API_HOST_PORT=28080
POSTGRES_HOST_PORT=25432
MINIO_API_HOST_PORT=29000
MINIO_CONSOLE_HOST_PORT=29001
WEB_HOST_PORT=23000
PROMETHEUS_HOST_PORT=29090
GRAFANA_HOST_PORT=23001
JAEGER_HOST_PORT=26686
